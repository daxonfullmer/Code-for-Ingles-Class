def changeLevelDimentions(level):
    global sprites
    if not isinstance(level, Floating):
        rightEdge, leftEdge, top, bottom = [], [], [], []
        for block in level.statics:
            rightEdge.append(block[0]+block[2]//2)
        rightEdge = max(rightEdge)
        for block in level.statics:
            leftEdge.append(block[0]-block[2]//2)
        leftEdge = min(leftEdge)
        for block in level.statics:
            top.append(block[1]-block[3]//2)
        top = min(top)
        for block in level.statics:
            bottom.append(block[1]+block[3]//2)
        bottom = max(bottom)
        level.prevWidth = level.width
        level.prevHeight = level.height
        level.width = rightEdge - leftEdge
        level.height = bottom - top
        for block in level.statics:
            block[0] -= rightEdge-level.width//2
            block[1] -= bottom - level.height//2

