running = True
while running:
    for event in pygame.event.get():
        keys = pygame.key.get_pressed()
        if event.type == pygame.QUIT:
            running = False
        if keypress(pygame.K_UP): upPress = True
        if keypress(pygame.K_DOWN): downPress = True
        isPortal = False
        if teleport:
            for object in objects:
                if isinstance(object, Teleportal): isPortal = True
            if downPress and not keys[pygame.K_RIGHT] and not keys[pygame.K_LEFT]:
                if not isPortal and player.grounded:
                    portalObject = Teleportal(player.pos.x, player.pos.y, 15, 10, 0)
                    objects.append(portalObject)
            if downPress and not keys[pygame.K_RIGHT] and not keys[pygame.K_LEFT] and isPortal:
                player.pos = portalObject.pos
                player.pos.y -= 30
                objects.remove(portalObject)
                isPortal = False
        if keypress(pygame.K_r):
            if keys[pygame.K_LSHIFT] or keys[pygame.K_RSHIFT]:
                createLevelSet()
            if isinstance(levels[0][0], Default):
                progress += 1
                createLevelSet()
            else: enterLevel()
        if kindaDebug == True:
            if keypress(pygame.K_a):
                progress += 1
                print(progress)
            if (keys[pygame.K_LSHIFT] or keys[pygame.K_RSHIFT]) and keypress(pygame.K_a):
                progress -= 1
                print(progress)
            if keypress(pygame.K_q):
                fly = not fly
                if player.gravity == 0: player.gravity = 1
            if keypress(pygame.K_s):
                debugToggle = not debugToggle
            if keypress(pygame.K_w):
                player.pos = pygame.Vector2(pygame.mouse.get_pos())
                player.vel = pygame.Vector2(0, 0)
                player.updatePrevPos()
            if keypress(pygame.K_e): print(player.pos)
            if keypress(pygame.K_t): frameTimer = not frameTimer
            if keypress(pygame.K_EQUALS): FPS *= 1.2
            if keypress(pygame.K_MINUS): FPS /= 1.2
            if keys[pygame.K_MINUS] and keys[pygame.K_EQUALS]: FPS = 60
            if keypress(pygame.K_b): objects.append(Square(pygame.mouse.get_pos()[0], pygame.mouse.get_pos()[1], 50, 50, 0))
    if timestop:
        if downTimer == 30:
            if FPS == 60:
                FPS = 20
                player.red = 128
                player.blue = 128
                downTimer = 0
        elif downTimer == 20:
            if FPS == 20:
                FPS = 60
                player.red = 255
                player.blue = 255
                downTimer = 0

    if detectPlayer > 0: detectPlayer -= 1
    if detectPlayer == 0: player.detectInput(keys, upPress, downPress)
    screen.fill((backgroundRed, backgroundGreen, backgroundBlue))
    updatetotals()
    player.rightWalled = False
    player.leftWalled = False
    player.kindaRightWalled = False
    player.kindaLeftWalled = False
    upPress = False
    downPress = False
